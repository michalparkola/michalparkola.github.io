---
const title = 'Our Blessed Homeland / Their Barbarous Wastes — Tom Gauld';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta
      name="description"
      content="Our Blessed Homeland / Their Barbarous Wastes, a cartoon by Tom Gauld."
    />
  </head>
  <body>
    <main>
      <img
        src="/gauld.jpeg"
        alt="Tom Gauld cartoon contrasting how two mirrored societies describe themselves and each other."
        width="800"
        height="508"
      />
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    min-height: 100%;
  }

  :global(body) {
    background: #eef7fa;
  }

  main {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: clamp(0.5rem, 2vw, 1.5rem);
  }

  img {
    display: block;
    width: min(100%, 800px);
    height: auto;
  }
</style>
