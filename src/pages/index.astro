---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import photo from "../assets/michal-parkola.jpg";

const pickedSlugs = [
    "i-used-claude-code-as-my-productivity-coach-for-a-week",
    "fast-decision-making-method-for-teams",
    "psychological-safety-5-things",
    "organize-your-communication-around-focused-work",
    "how-to-become-a-great-team",
    "three-pits-of-team-despair",
];

const allPosts = await getCollection("blog");
const pickedPosts = pickedSlugs
    .map((slug) => allPosts.find((p) => p.id === slug))
    .filter(Boolean);
---

<BaseLayout title="Michał Parkoła">
    <div class="page">
        <section class="intro">
            <Image
                src={photo}
                alt="Michał Parkoła"
                class="photo"
                width={120}
                format="webp"
                quality={85}
            />
            <p>
                Hi! My name is Michał. I solve discovery and delivery problems
                for software founders. I helped scale <a href="https://appsilon.com/"
                    >Appsilon</a
                > from 25 to 100 people in about 2 years. Now I'm running <a
                    href="https://reinvent.michalparkola.com/">re_invent</a>, building <a
                    href="http://tapestry.tools/">tapestry.tools</a>, and co-organizing <a
                    href="https://kolektyw3.pl/">Kolektyw3</a>.
            </p>

            <p class="cta">
                <a href="/work-with-me/">Work with me →</a>
            </p>
        </section>

        <section class="highlight">
            <p>
                <strong>🌱 Struggling with lack of demand? Get a new client
                in a promising niche in 30 days.</strong> With <a
                    href="https://reinvent.michalparkola.com/">re_invent</a>, choose
                a niche based on your authentic advantages, have 30 discovery
                conversations, and turn those conversations into clients. Four
                weeks of intensive work plus five months of group support. <a
                    href="https://reinvent.michalparkola.com/">Details →</a>
            </p>
        </section>

        <section class="projects">
            <h2>Projects</h2>
            <ul>
                <li>
                    🌱 <a href="https://reinvent.michalparkola.com/">re_invent</a>:
                    get a new client in a promising niche
                </li>
                <li>
                    🧶 <a href="http://tapestry.tools/">tapestry.tools</a>: a suite
                    of tools that turn ideas into actions and make progress visible
                    across people and AI agents
                </li>
                <li>
                    🏠 <a href="https://kolektyw3.pl/">Kolektyw3</a>: a community
                    of founders and coworking space in Warsaw
                </li>
            </ul>
        </section>

        <section class="writing">
            <h2>Selected writing</h2>
            <ul>
                {
                    pickedPosts.map((post) => (
                        <li>
                            <a href={`/blog/${post.id}/`}>
                                {post.data.title}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <p class="more-link">
                <a href="/blog/">All articles →</a>
            </p>
        </section>

        <section class="projects">
            <h2>Other works</h2>
            <ul>
                <li>
                    🌐 <a href="https://fluidcircle.net"> FluidCircle.net</a> an in-depth
                    guide to Scrum and other Agile topics (in Polish).
                </li>
                <li>
                    📚 <a href="https://michalparkola.gumroad.com/">Books</a> about
                    <a
                        href="https://michalparkola.gumroad.com/l/jak-zmienic-swiat?layout=profile"
                        >change management</a
                    > (translation) and <a
                        href="https://michalparkola.gumroad.com/l/LAO"
                        >communication</a
                    > (chapter).
                </li>
            </ul>
        </section>
    </div>
</BaseLayout>

<style>
    .intro {
        margin: 2rem 0 3rem;
    }

    .photo {
        border-radius: 50%;
        float: right;
        margin: 0 0 1rem 1.5rem;
    }

    .intro p {
        margin-bottom: 1rem;
    }

    .intro a {
        color: #5c8d11;
        text-decoration: none;
    }

    .intro a:hover {
        text-decoration: underline;
    }

    .intro .cta {
        margin-top: 1.5rem;
    }

    .intro .cta a {
        font-weight: 600;
        font-size: 1.1rem;
    }

    h2 {
        font-size: 1.5rem;
        color: #2c3e50;
        margin-bottom: 1rem;
    }

    .highlight {
        background: #f4f9ec;
        border-left: 4px solid #5c8d11;
        border-radius: 0 8px 8px 0;
        padding: 1rem 1.5rem;
        margin-bottom: 3rem;
    }

    .highlight p {
        margin: 0;
    }

    .highlight a {
        color: #5c8d11;
        text-decoration: none;
    }

    .highlight a:hover {
        text-decoration: underline;
    }

    .projects,
    .writing {
        margin-bottom: 3rem;
    }

    .projects ul,
    .writing ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .projects li {
        margin-bottom: 0.75rem;
    }

    .projects li a {
        color: #2c3e50;
        text-decoration: none;
        font-weight: 600;
    }

    .projects li a:hover {
        color: #5c8d11;
    }

    .writing li {
        padding: 0.4rem 0;
    }

    .writing li a {
        color: #2c3e50;
        text-decoration: none;
        font-weight: 500;
    }

    .writing li a:hover {
        color: #5c8d11;
    }

    .writing time {
        color: #999;
        font-size: 0.85rem;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .more-link {
        margin-top: 1rem;
    }

    .more-link a {
        color: #5c8d11;
        text-decoration: none;
        font-weight: 500;
    }

    .more-link a:hover {
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .intro p {
            font-size: 1.05rem;
        }

        .writing li {
            flex-direction: column;
            gap: 0.25rem;
        }
    }
</style>
