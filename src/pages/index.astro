---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { reinventUrl, resolveReading } from "../data/reinvent-reading";

const reading = resolveReading(await getCollection("blog"));
---

<BaseLayout title="Michał Parkoła">
    <div class="page">
        <section class="intro">
            <p>
                I’m Michał Parkoła. I help software and AI founders understand
                customer problems and develop offers.
            </p>
            <p>
                I helped <a href="https://appsilon.com/">Appsilon</a> grow from
                25 to 100 people in about two years. I run <a href={reinventUrl}
                    >re_invent</a
                >, build <a href="http://tapestry.tools/">tapestry.tools</a>,
                and co-organize <a href="https://kolektyw3.pl/">Kolektyw3</a> in
                Warsaw.
            </p>
        </section>

        <section class="highlight">
            <h2>Conversations first. Then the offer.</h2>
            <p>
                re_invent helps technical founders of software and AI companies
                find out what people want and develop a better offer. Build an
                offer you can scale, instead of chasing the next random project.
            </p>
            <p class="cta">
                <a href={reinventUrl}>Explore re_invent (in Polish) →</a>
            </p>
        </section>

        <section class="writing">
            <h2>Understand customers and develop your offer</h2>
            <p>These articles explain ideas I use in re_invent.</p>
            <ul>
                {
                    reading.map((item) => (
                        <li>
                            <a href={`/blog/${item.post.id}/`}>{item.title}</a>{" "}
                            — {item.summary}
                        </li>
                    ))
                }
            </ul>
            <p class="more-link">
                <a href="/blog/">All articles →</a>
            </p>
        </section>

        <section class="projects">
            <h2>Other projects and published work</h2>
            <ul>
                <li>
                    🧶 <a href="http://tapestry.tools/">tapestry.tools</a>: a suite
                    of tools that turn ideas into actions and make progress visible
                    across people and AI agents
                </li>
                <li>
                    🏠 <a href="https://kolektyw3.pl/">Kolektyw3</a>: a community
                    of founders and coworking space in Warsaw
                </li>
                <li>
                    🌐 <a href="https://fluidcircle.net"> FluidCircle.net</a> an in-depth
                    guide to Scrum and other Agile topics (in Polish).
                </li>
                <li>
                    📚 <a href="https://michalparkola.gumroad.com/">Books</a> about
                    <a
                        href="https://michalparkola.gumroad.com/l/jak-zmienic-swiat?layout=profile"
                        >change management</a
                    > (translation) and <a
                        href="https://michalparkola.gumroad.com/l/LAO"
                        >communication</a
                    > (chapter).
                </li>
            </ul>
        </section>
    </div>
</BaseLayout>

<style>
    .intro {
        margin: 2rem 0 3rem;
    }

    .intro p {
        margin-bottom: 1rem;
    }

    .intro a {
        color: #5c8d11;
        text-decoration: none;
    }

    .intro a:hover {
        text-decoration: underline;
    }

    h2 {
        font-size: 1.5rem;
        color: #2c3e50;
        margin-bottom: 1rem;
    }

    .highlight {
        background: #f4f9ec;
        border-left: 4px solid #5c8d11;
        border-radius: 0 8px 8px 0;
        padding: 1rem 1.5rem;
        margin-bottom: 3rem;
    }

    .highlight h2 {
        margin-top: 0.5rem;
    }

    .highlight p {
        margin: 0 0 0.75rem;
    }

    .highlight .cta a {
        font-weight: 600;
    }

    .highlight a {
        color: #5c8d11;
        text-decoration: none;
    }

    .highlight a:hover {
        text-decoration: underline;
    }

    .projects,
    .writing {
        margin-bottom: 3rem;
    }

    .projects ul,
    .writing ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .projects li {
        margin-bottom: 0.75rem;
    }

    .projects li a {
        color: #2c3e50;
        text-decoration: none;
        font-weight: 600;
    }

    .projects li a:hover {
        color: #5c8d11;
    }

    .writing li {
        padding: 0.4rem 0;
    }

    .writing li a {
        color: #2c3e50;
        text-decoration: none;
        font-weight: 500;
    }

    .writing li a:hover {
        color: #5c8d11;
    }

    .writing time {
        color: #999;
        font-size: 0.85rem;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .more-link {
        margin-top: 1rem;
    }

    .more-link a {
        color: #5c8d11;
        text-decoration: none;
        font-weight: 500;
    }

    .more-link a:hover {
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .intro p {
            font-size: 1.05rem;
        }

        .writing li {
            flex-direction: column;
            gap: 0.25rem;
        }
    }
</style>
