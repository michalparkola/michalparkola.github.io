---
import BaseLayout from "../layouts/BaseLayout.astro";
import { reinventUrl } from "../data/reinvent-reading";
---

<BaseLayout
    title="Contact Michał Parkoła"
    description="Contact Michał Parkoła about re_invent, invitations, or other questions."
>
    <div class="page">
        <h1>Contact Michał</h1>
        <p>
            For customer discovery and offer development, see
            <a href={reinventUrl}>re_invent</a>. The program is in Polish.
        </p>
        <p>
            For other questions or invitations, email
            <a href="mailto:michal.parkola@gmail.com">michal.parkola@gmail.com</a>.
        </p>
        <p>
            You can find my background on
            <a href="https://www.linkedin.com/in/michalparkola/">LinkedIn</a>
            and my articles in the <a href="/blog/">writing archive</a>.
        </p>
    </div>
</BaseLayout>

<style>
    h1 {
        font-size: 2.5rem;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    a {
        color: #5c8d11;
    }
</style>
